# Backend API origin used by Nuxt server routes (/api/login, /api/logs, /api/logout).
# Set in Amplify Console → Environment variables (branch main), then redeploy.
# Amplify only applies NUXT_* at build time — see amplify.yml and nuxt.config.ts.
NUXT_BACKEND_API_ORIGIN=http://ec2-32-196-230-248.compute-1.amazonaws.com:8080

# Optional: override the public app title
# NUXT_PUBLIC_TITLE=Logging System
